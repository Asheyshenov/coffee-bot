#!/usr/bin/env ruby
# frozen_string_literal: true

# Database Migrations Entry Point
# Applies pending migrations from db/migrations to DATABASE_URL and exits.
# Run it once before starting bin/bot and bin/callback_app
# (docker-compose does it in the one-shot "migrate" service),
# so the two app processes never race each other on migrations.
# Exits with status 1 if a migration fails.

# Add lib directory to load path
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

# Load configuration and database
require_relative '../config/boot'

begin
  log_info('Running database migrations...',
    environment: CoffeeBot::Config::RACK_ENV,
    version_before: CoffeeBot::DB.schema_version
  )

  CoffeeBot::DB.run_migrations!

  log_info('Migrations completed successfully', version: CoffeeBot::DB.schema_version)
rescue StandardError => e
  log_error('Migration failed', error: "#{e.class}: #{e.message}", backtrace: e.backtrace&.first(5))
  exit 1
end
