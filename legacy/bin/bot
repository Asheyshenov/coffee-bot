#!/usr/bin/env ruby
# frozen_string_literal: true

# Telegram Bot Entry Point
# This script starts the Telegram bot in polling mode together with
# the background jobs (StatusSyncer, InvoiceExpirer).
# The database schema must be up to date: run bin/migrate first
# (docker-compose does it in the one-shot "migrate" service).

# Add lib directory to load path
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

# Load configuration and database
require_relative '../config/boot'

# Load all models
Dir[File.expand_path('../lib/models/*.rb', __dir__)].sort.each { |f| require f }

# Load all services
Dir[File.expand_path('../lib/services/**/*.rb', __dir__)].sort.each { |f| require f }

# Load bot router
require_relative '../lib/bot/router'

# Load jobs
require_relative '../lib/jobs/status_syncer'
require_relative '../lib/jobs/invoice_expirer'

# Jobs rescue errors of every run themselves; anything that still kills
# a job thread is logged here instead of the job silently disappearing
def watch_job_thread(name, thread)
  return unless thread.is_a?(Thread)

  thread.name = name
  thread.report_on_exception = false # reported below in our log format

  Thread.new do
    thread.join
  rescue Exception => e # rubocop:disable Lint/RescueException
    log_error("#{name} thread died, job is no longer running",
      error: "#{e.class}: #{e.message}",
      backtrace: e.backtrace&.first(5)
    )
  end
end

# Start the bot
log_info('Starting Coffee Bot...',
  environment: CoffeeBot::Config::RACK_ENV,
  database: CoffeeBot::Config::DATABASE_URL.split('/').last
)

# Initialize background jobs
status_syncer = CoffeeBot::Jobs::StatusSyncer.new(interval_seconds: 2)
invoice_expirer = CoffeeBot::Jobs::InvoiceExpirer.new(interval_seconds: 60)

begin
  # Start background jobs in same lifecycle as bot
  watch_job_thread('StatusSyncer', status_syncer.start)
  watch_job_thread('InvoiceExpirer', invoice_expirer.start)

  bot = Telegram::Bot::Client.new(CoffeeBot::Config::TELEGRAM_BOT_TOKEN)

  # Run bot with router
  bot.run do |bot_instance|
    CoffeeBot::Bot::Router.new(bot_instance).run
  end
rescue Interrupt
  log_info('Bot stopped by user')
rescue SignalException => e
  # SIGTERM from `docker stop` / systemd
  log_info('Bot stopped by signal', signal: e.signm)
rescue StandardError => e
  log_error('Bot crashed', error: e.message, backtrace: e.backtrace.first(5))
  raise
ensure
  # Stop background jobs on exit
  status_syncer&.stop
  invoice_expirer&.stop
  log_info('Background jobs stopped')
end
