# Coffee Bot: environment settings. Copy to .env (bin/setup does it) and fill in.
# .env is gitignored and never goes into the Docker image. Development and tests load it
# via dotenv; docker compose passes it to the app container (env_file).
# Bot tokens and MWallet credentials of coffee shops are NOT set here: they are stored
# encrypted in the database (bin/rails tenants:connect_bot / tenants:connect_mwallet).

# ========================================
# Public URL
# ========================================
# Public HTTPS address of this app, without a trailing slash. Telegram webhooks
# (/tg/:bot_id) and O!Dengi callbacks (/pay/mwallet/:payment_account_id) are built from it,
# and in production it is the only host the app answers for.
# Production: https://coffee.example.com. Locally: a tunnel URL (see README), or
# http://localhost:3000 when no webhooks are needed.
PUBLIC_BASE_URL=http://localhost:3000

# Production only: extra host names accepted besides the PUBLIC_BASE_URL host, comma-separated
# RAILS_EXTRA_HOSTS=

# Development only: tunnel hosts Rails may answer for (a leading dot allows subdomains)
# RAILS_DEVELOPMENT_HOSTS=.trycloudflare.com,.ngrok-free.app

# ========================================
# Database
# ========================================
# Password of the Postgres container in docker-compose.yml [required for docker compose].
# Letters and digits only (it is embedded into a URL), e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Production without docker compose (docker compose builds DATABASE_URL itself).
# Development and tests use the local Postgres from config/database.yml instead.
# DATABASE_URL=postgres://coffee:password@db-host:5432/coffee_bot

# Connections per process in production. Must be at least RAILS_MAX_THREADS and at
# least the Solid Queue worker threads (3, config/queue.yml) + 2. With SOLID_QUEUE_IN_PUMA
# Puma, the worker and the dispatcher/scheduler each hold their own pool: Postgres
# max_connections (100 by default) must cover the total.
# DB_POOL=15

# ========================================
# Secrets
# ========================================
# Active Record encryption keys for bot tokens and MWallet passwords [required].
# Generate once with `bin/rails db:encryption:init` (bin/setup fills them in for development)
# and keep them safe: without them the stored credentials cannot be decrypted.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Production: the content of config/master.key (decrypts config/credentials.yml.enc,
# which holds secret_key_base). Alternatively set SECRET_KEY_BASE (`bin/rails secret`).
RAILS_MASTER_KEY=
# SECRET_KEY_BASE=

# ========================================
# Processes
# ========================================
# Run Solid Queue jobs inside Puma: one process for web and jobs. docker-compose.yml sets
# it to true itself; bin/dev always runs jobs as a separate process (bin/jobs).
# SOLID_QUEUE_IN_PUMA=true

# Solid Queue worker processes (config/queue.yml), 3 threads each. Default: 1
# JOB_CONCURRENCY=1

# Puma threads per process. Default: 3
# RAILS_MAX_THREADS=3

# Log level in production: debug, info, warn, error. Default: info
# RAILS_LOG_LEVEL=info

# ========================================
# docker compose
# ========================================
# Where the app is published on the host. Default 127.0.0.1:3000 (behind a reverse proxy
# or tunnel on the same machine).
# APP_BIND=127.0.0.1
# APP_PORT=3000

# Let Thruster obtain a Let's Encrypt certificate itself (publish ports 80 and 443 in
# docker-compose.yml then): the domain of PUBLIC_BASE_URL
# TLS_DOMAIN=coffee.example.com

# ========================================
# O!Dengi (MWallet)
# ========================================
# Production API URL for coffee shops accepting real payments (tenants:connect_mwallet
# with test_mode=false). Confirm the exact URL with O!Dengi before going live.
# The test API URL is built in (PaymentAccount::TEST_BASE_URL).
MWALLET_PRODUCTION_BASE_URL=

# ========================================
# Legacy import (bin/rails "tenants:import_legacy_env[slug,Name]")
# ========================================
# Settings of the old single-shop app. Read ONLY by tenants:import_legacy_env, which turns
# them into tenant #1. Remove them from .env after the import.
# TELEGRAM_BOT_TOKEN=123456789:bot-token-from-BotFather
# MWALLET_SID=your_sid
# Quote the password if it contains # or spaces
# MWALLET_PASSWORD='your_password'
# true = test API (default), false = live payments (needs MWALLET_PRODUCTION_BASE_URL or MWALLET_BASE_URL)
# MWALLET_TEST_MODE=true
# MWALLET_BASE_URL=https://mw-api-test.dengi.kg/api/json/json.php
# MWALLET_API_VERSION=1005
# Telegram user ids of the baristas, comma-separated
# BARISTA_WHITELIST=123456789,987654321
# Minutes before an unpaid invoice expires (1-120)
# ORDER_EXPIRE_MINUTES=15
