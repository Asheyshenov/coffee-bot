# Coffee Bot Environment Configuration
# Copy this file to .env and fill in your values
# docker-compose reads the same .env; variables marked [required in Docker]
# make `docker compose` fail fast when they are missing.

# ========================================
# Telegram Bot Configuration
# ========================================
# Get your bot token from @BotFather on Telegram  [required in Docker]
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ========================================
# Database Configuration
# ========================================
# SQLite (for development):
DATABASE_URL=sqlite://db/development.sqlite3

# PostgreSQL (for production without Docker):
# DATABASE_URL=postgres://username:password@localhost:5432/coffee_bot

# Password of the Postgres container in docker-compose  [required in Docker]
# docker-compose builds DATABASE_URL from it itself (the DATABASE_URL above is ignored there).
# Use letters and digits only (it is embedded into a URL), e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Migrations: in development they run automatically on start.
# In production run `bin/migrate` once before starting bin/bot and bin/callback_app
# (docker-compose does it in the one-shot "migrate" service).

# ========================================
# Barista Access Control
# ========================================
# Comma-separated list of Telegram user IDs allowed to access barista panel  [required in Docker]
# Get your Telegram user ID from @userinfobot
BARISTA_WHITELIST=123456789,987654321

# ========================================
# Order Settings
# ========================================
# Minutes before unpaid invoice expires (InvoiceExpirer then cancels it and notifies the client)
ORDER_EXPIRE_MINUTES=15

# ========================================
# MWallet API Configuration
# ========================================
# API base URL (test server by default)
MWALLET_BASE_URL=https://mw-api-test.dengi.kg/api/json/json.php

# Your service ID and password from MWallet  [required in Docker]
MWALLET_SID=your_sid
# Use quotes if the password contains # or special chars
MWALLET_PASSWORD='your_password'

# API version (default: 1005)
# MWALLET_API_VERSION=1005

# Test mode (true for sandbox, false for real payments)
MWALLET_TEST_MODE=true

# ========================================
# Callback Server Configuration
# ========================================
# Public URL where MWallet sends payment callbacks  [required in Docker]
# Must be reachable from the internet (HTTPS reverse proxy / tunnel -> callback PORT).
# In production the callback server accepts only requests for this host.
PUBLIC_BASE_URL=https://your-domain.com

# Port of the callback server (bin/callback_app, Puma). Default: 9292
# Listens on 0.0.0.0 when RACK_ENV=production, on localhost otherwise.
# PORT=9292

# Development only: extra hosts permitted by the callback server (tunnels), comma-separated
# TUNNEL_HOSTS=.trycloudflare.com

# ========================================
# Payment Provider Timeouts (optional)
# ========================================
# Request timeout in seconds
# MWALLET_TIMEOUT_SECONDS=30

# Number of retry attempts for failed requests
# MWALLET_RETRY_COUNT=3

# ========================================
# QRPay / O!Деньги Configuration (legacy, not used by the bot)
# ========================================
# QRPAY_BASE_URL=https://api.odengi.kg
# QRPAY_MERCHANT_ID=your_merchant_id
# QRPAY_SECRET_KEY=your_secret_key
# QRPAY_TIMEOUT_SECONDS=30
# QRPAY_RETRY_COUNT=3

# ========================================
# Application Environment
# ========================================
# Set to 'production' for production deployment (docker-compose sets it itself)
RACK_ENV=development
